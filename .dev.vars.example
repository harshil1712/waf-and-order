# Shared read-only Cloudflare API token
# ------------------------------------------------------------------
# CLOUDFLARE_READ_TOKEN is used by:
#   - the deterministic scheduled GraphQL analytics collector, and
#   - the model-facing MCP search connection (search only — never execute).
# It is a WORKER SECRET, never a wrangler var: set it in production with
#   npx wrangler secret put CLOUDFLARE_READ_TOKEN
# For local dev, replace the placeholder below.
# Required permission: All Domains > Zone Analytics > Read. Scope it to all
# domains for multi-zone use, or only the domains registered in this
# application. Do not grant any write permissions.
CLOUDFLARE_READ_TOKEN="replace-with-a-read-only-cloudflare-api-token"

# Approval workflow
# ------------------------------------------------------------------
# APPROVAL_TOKEN_SECRET signs the expiring, single-use approval reply tokens.
# It is a WORKER SECRET and a cryptographic secret (not a Cloudflare API token),
# never a wrangler var: set it in production with
#   npx wrangler secret put APPROVAL_TOKEN_SECRET
# For local dev, set it here in .dev.vars (replace the placeholder with a long
# random value, e.g. `openssl rand -hex 32`). The agent and the email handler
# read it via process.env.APPROVAL_TOKEN_SECRET and fail closed when unset.
APPROVAL_TOKEN_SECRET="replace-with-a-long-random-secret"
